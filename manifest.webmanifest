    { "src": "assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Passport photo", "url": "./#/tool/passportphoto", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Scan QR", "url": "./#/tool/qrscan", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Compress PDF", "url": "./#/tool/pdfcompress", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] }
  ]
